{
  "name": "@pixishelf/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "generate": "pnpm db:generate",
    "validate": "pnpm db:validate",
    "push": "pnpm db:push",
    "migrate": "pnpm db:migrate",
    "deploy": "pnpm db:deploy",
    "studio": "pnpm db:studio",
    "test": "vitest run prisma/__tests__ src/__tests__",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^5.17.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}

model PixivMetadataInventoryState {
  id                  String                       @id @default("pixiv") @db.VarChar(40)
  status              PixivMetadataInventoryStatus @default(INITIALIZING)
  /// Hashing the resolved root prevents a different mount from silently inheriting an existing baseline.
  rootPathHash        String                       @db.VarChar(64)
  rootDeviceId        BigInt?
  rootInode           BigInt?
  baselineGeneration  Int                          @default(1)
  baselineStartedAt   DateTime                     @default(now())
  baselineCompletedAt DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@map("pixiv_metadata_inventory_state")
}

model PixivMetadataInventory {
  id                       String              @id @default(cuid())
  relativePath             String              @unique @db.Text
  externalId               String?
  sizeBytes                BigInt
  mtimeMs                  BigInt
  ctimeMs                  BigInt?
  deviceId                 BigInt?
  inode                    BigInt?
  /// Last content that was read stably, whether or not its domain publication succeeded.
  observedContentHash      String?             @db.VarChar(64)
  /// Content whose Artwork/source changes committed atomically; a mismatch means synchronization is pending.
  processedContentHash     String?             @db.VarChar(64)
  /// Prevents unchanged permanent failures from being reparsed while retaining their diagnostic record.
  lastAttemptedContentHash String?             @db.VarChar(64)
  externalRefId            String?
  externalRef              ArtworkExternalRef? @relation(fields: [externalRefId], references: [id], onDelete: SetNull)
  baselineGeneration       Int                 @default(1)
  /// True only for content frozen by the first complete traversal but not yet classified.
  baselineEligible         Boolean             @default(false)
  /// ScanRun history is retained independently, so this operational sighting intentionally has no foreign key.
  lastSeenScanRunId        String?             @db.VarChar(30)
  /// Audit sighting is separate from discovery so incomplete audits cannot corrupt Stage 2 semantics.
  lastSeenAuditRunId       String?             @db.VarChar(30)
  lastAttemptedAt          DateTime?
  lastProcessedAt          DateTime?
  lastErrorCode            String?             @db.VarChar(80)
  lastErrorSummary         String?             @db.Text
  /// With an error: true retries, false caches an exact-content verdict, null reevaluates external state.
  lastErrorRetryable       Boolean?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([externalId])
  @@index([externalRefId])
  @@index([lastSeenScanRunId])
  @@index([lastSeenAuditRunId], map: "pixiv_metadata_inventory_last_audit_idx")
  @@index([lastErrorRetryable, updatedAt], map: "pixiv_metadata_inventory_retry_updated_idx")
  @@map("pixiv_metadata_inventory")
}


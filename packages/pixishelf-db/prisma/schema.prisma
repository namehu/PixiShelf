model Series {
  id             Int             @id @default(autoincrement())
  title          String
  description    String?
  coverImageUrl  String?
  source         String          @default("LOCAL") // 用于区分数据来源，'LOCAL'是自己建的，'PIXIV'是导入的
  externalId     String? // 用于存原来的Pixiv 系列 ID，比如 '123456'
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  artworks       Artwork[]
  seriesArtworks SeriesArtwork[]

  // 这个索引让数据库知道：同一个来源下的同一个外部ID，只能有一条记录
  @@unique([source, externalId])
}

// 定义枚举
enum SeriesType {
  LOCAL // 本地创建
  PIXIV // Pixiv 导入
}

enum ArtworkSource {
  LOCAL_CREATED
  PIXIV_IMPORTED
  LOCAL_IMPORT
  URL_ARCHIVE
}

model SeriesArtwork {
  seriesId  Int
  artworkId Int
  sortOrder Int
  series    Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([seriesId, artworkId])
  @@index([seriesId])
  @@index([artworkId])
}

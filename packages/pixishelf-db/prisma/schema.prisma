model ScanRun {
  id                          String                           @id @default(cuid())
  systemJobId                 String?                          @unique
  systemJob                   SystemJob?                       @relation(fields: [systemJobId], references: [id], onDelete: SetNull)
  type                        ScanRunType
  mode                        ScanRunMode
  status                      ScanRunStatus                    @default(RUNNING)
  startedAt                   DateTime?
  finishedAt                  DateTime?
  durationMs                  Int?
  inputDigest                 String?                          @db.VarChar(64)
  inputCount                  Int                              @default(0)
  inputFrozenAt               DateTime?
  /// Identifies the first-traversal baseline this run may classify; null for ordinary frozen scans.
  inventoryBaselineGeneration Int?
  /// Nullable varchar keeps historical ScanRunMode values readable while versioned SCAN operations evolve.
  operationKind               String?                          @db.VarChar(40)
  /// Evidence link to the immutable source audit selected by AUDIT_APPLY; deliberately not a domain FK.
  sourceAuditRunId            String?                          @db.VarChar(30)
  checkpointStage             String?                          @db.VarChar(80)
  checkpointOrdinal           Int                              @default(0)
  totalArtworks               Int                              @default(0)
  processedArtworks           Int                              @default(0)
  succeededArtworks           Int                              @default(0)
  skippedArtworks             Int                              @default(0)
  failedArtworks              Int                              @default(0)
  newArtists                  Int                              @default(0)
  newTags                     Int                              @default(0)
  newImages                   Int                              @default(0)
  walkedEntries               Int?
  metadataCandidates          Int?
  inventoryUnchanged          Int?
  contentHashed               Int?
  contentChanged              Int?
  parsedInputs                Int?
  publishedInputs             Int?
  failedInputs                Int?
  missingInputs               Int?
  auditNewInputs              Int?
  auditChangedInputs          Int?
  auditInvalidInputs          Int?
  auditIdentityConflictInputs Int?
  auditApplyStaleInputs       Int?
  auditApplyConflictInputs    Int?
  discoveryDurationMs         Int?
  hashDurationMs              Int?
  publishDurationMs           Int?
  errorMessage                String?                          @db.Text
  logRef                      String?                          @db.Text
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  items                       ScanRunItem[]
  metadataInputs              ScanRunMetadataInput[]
  sourceAuditItems            PixivSourceAuditItem[]
  localWorkInputs             ScanRunLocalWorkInput[]
  localArtistMappingInputs    ScanRunLocalArtistMappingInput[]

  @@index([startedAt])
  @@index([status, startedAt])
  @@index([type, mode, startedAt])
  @@index([sourceAuditRunId, createdAt], map: "scan_runs_source_audit_created_idx")
  @@map("scan_runs")
}

model ScanRunItem {

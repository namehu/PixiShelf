{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rewriteRelativeImportExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@pixishelf/job-contracts": ["../pixishelf-job-contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "prisma/__tests__/**/*.ts", "vitest.config.ts"]
}

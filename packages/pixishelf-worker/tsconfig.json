{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pixishelf/db": ["../pixishelf-db/src/index.ts"],
      "@pixishelf/job-contracts": ["../pixishelf-job-contracts/src/index.ts"],
      "@pixishelf/job-runtime": ["../pixishelf-job-runtime/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.mjs", "vitest.config.ts"]
}

{
  "name": "@pixishelf/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "pnpm run clean && node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/main.ts",
    "healthcheck": "node dist/healthcheck.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@pixishelf/db": "workspace:*",
    "@pixishelf/job-contracts": "workspace:*",
    "@pixishelf/job-runtime": "workspace:*",
    "@prisma/client": "^5.17.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "^4.0.18"
  }
}

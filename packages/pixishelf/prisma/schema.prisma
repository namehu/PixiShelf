model ScanRun {
  id                String        @id @default(cuid())
  systemJobId       String?
  systemJob         SystemJob?    @relation(fields: [systemJobId], references: [id], onDelete: SetNull)
  type              ScanRunType
  mode              ScanRunMode
  status            ScanRunStatus @default(RUNNING)
  startedAt         DateTime      @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  totalArtworks     Int           @default(0)
  processedArtworks Int           @default(0)
  succeededArtworks Int           @default(0)
  skippedArtworks   Int           @default(0)
  failedArtworks    Int           @default(0)
  newArtists        Int           @default(0)
  newTags           Int           @default(0)
  newImages         Int           @default(0)
  errorMessage      String?       @db.Text
  logRef            String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             ScanRunItem[]

  @@index([startedAt])
  @@index([status, startedAt])
  @@index([type, mode, startedAt])
  @@index([systemJobId])
  @@map("scan_runs")
}

model ScanRunItem {
  id                   String            @id @default(cuid())
  scanRunId            String
  scanRun              ScanRun           @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  externalId           String?
  title                String?
  artistName           String?
  relativeDirectory    String?           @db.Text
  metadataRelativePath String?           @db.Text
  status               ScanRunItemStatus
  action               ScanRunItemAction
  mediaCount           Int               @default(0)
  newImageCount        Int               @default(0)
  errorMessage         String?           @db.Text
  startedAt            DateTime          @default(now())
  finishedAt           DateTime?
  durationMs           Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([scanRunId, status])
  @@index([scanRunId, action])
  @@index([externalId])
  @@map("scan_run_items")
}

enum ScanRunType {
  PIXIV
  LOCAL_IMPORT
  LOCAL_CREATE
  BATCH_IMPORT
}

enum ScanRunMode {
  FULL
  INCREMENTAL
  CLIENT_LIST
  RESCAN
  LOCAL_RESCAN
  LOCAL_DIRECTORY_IMPORT
  LOCAL_CREATE
  BATCH_CREATE
  BATCH_REGISTER_IMAGES
}

enum ScanRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanRunItemStatus {
  SUCCESS
  SKIPPED
  FAILED
}

enum ScanRunItemAction {
  CREATE
  UPDATE
  SKIP_EXISTING
  SKIP_INVALID_METADATA
  SKIP_NO_MEDIA
  FAILED_PARSE
  FAILED_COLLECT
  FAILED_WRITE
}

model ScheduledTask {
  id                   String       @id @default(cuid())
  key                  String       @unique @db.VarChar(80)
  type                 String       @db.VarChar(80)
  enabled              Boolean      @default(false)
  scheduleMode         ScheduleMode @default(DAILY)
  time                 String       @db.VarChar(5)
  timezone             String       @default("Asia/Shanghai") @db.VarChar(50)
  priority             Int          @default(100)
  mutexKey             String?      @db.VarChar(80)
  lastTriggeredAt      DateTime?
  lastTriggeredDate    String?      @db.VarChar(10)
  lastMaterializedAt   DateTime?
  lastMaterializedDate String?      @db.VarChar(10)
  lastJobId            String?
  config               Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  jobs                 SystemJob[]

  @@index([enabled, priority])
  @@index([type])
  @@index([mutexKey])
  @@map("scheduled_tasks")
}


{
  "name": "@pixishelf/archive-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm clean && esbuild src/archive-worker.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/archive-worker.cjs --tsconfig=../pixishelf/tsconfig.json --external:@prisma/client --external:sharp && esbuild ../pixishelf/scripts/archive-identity-report.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/archive-identity-report.cjs --tsconfig=../pixishelf/tsconfig.json --external:@prisma/client",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx --tsconfig ../pixishelf/tsconfig.json src/archive-worker.ts"
  },
  "dependencies": {
    "@pixishelf/db": "workspace:*",
    "@pixishelf/job-contracts": "workspace:*",
    "@prisma/client": "^5.17.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "prisma": "^5.17.0",
    "tsx": "^4.20.6"
  }
}

classDiagram
    class AutoBrowseStore {
        pause()
        resume()
        finishAnimation()
    }
    class ReactAdapter {
        mapIntent()
        handleEvent()
        fallback()
    }
    class WebpPlayer {
        load(source)
        play()
        pause()
        destroy()
    }
    class PreviewSession {
        clearOnAccountOrScopeChange()
    }
    class PlaybackPressure {
        observeServiceTime()
        accumulateEffectiveMediaTime()
    }
    class CompressedInputCache {
        connect()
        validateEOF()
        release()
        clear()
    }
    class DecodeCadence {
        selectIndependentFrame()
        presentationDeadline()
    }
    class MediaClock {
        position
        tick(now, inputHorizon)
        pause()
        resume()
    }
    class FrameClock {
        remainingMs
        advance()
        pause()
    }
    class PlayerAssetSessionStore {
        loadManifest()
        setSessionOwner()
        reset()
    }
    class CoordinatorWorker {
        independentGate()
        boundedReadAhead()
        omitExpiredFrames()
        fourOutputPermits()
        fallbackSequential()
    }
    class ReplayInput {
        readStream()
        retainCompressedBlocks()
        rewind()
    }
    class IndependentWorker {
        decodeVP8()
        recycleBuffer()
    }
    class SequentialDecoder {
        append()
        replayDeliveredFrames()
        compositeNext()
        repeat()
    }
    AutoBrowseStore --> ReactAdapter : intent / events
    ReactAdapter *-- WebpPlayer
    ReactAdapter --> PreviewSession
    PreviewSession *-- PlaybackPressure
    PreviewSession *-- CompressedInputCache
    WebpPlayer --> PlaybackPressure : reduce after sustained load
    WebpPlayer --> CompressedInputCache : optional input lease
    CompressedInputCache --> ReplayInput : bounded MessagePort reads
    CoordinatorWorker *-- DecodeCadence : independent frames only
    ReactAdapter --> PlayerAssetSessionStore : shared manifest
    WebpPlayer *-- MediaClock : independent and midstream fallback
    WebpPlayer *-- FrameClock : direct sequential path
    WebpPlayer --> CoordinatorWorker : target time / transferable buffers
    CoordinatorWorker *-- ReplayInput : one media request
    CoordinatorWorker *-- "2" IndependentWorker : scalar or SIMD WASM
    CoordinatorWorker --> SequentialDecoder : unsupported or midstream fallback
    SequentialDecoder --> ReplayInput : reuse retained input

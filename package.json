{
  "name": "pixishelf",
  "version": "1.0.0",
  "description": "A modern personal web gallery for local image collections",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --r build",
    "db:generate": "pnpm --filter @pixishelf/db db:generate",
    "worker:build": "pnpm --filter @pixishelf/worker... build",
    "worker:test": "pnpm --filter @pixishelf/worker... test",
    "worker:typecheck": "pnpm --filter @pixishelf/worker... typecheck",
    "check:quick": "pnpm --filter @pixishelf/next check:quick",
    "check:full": "pnpm --filter @pixishelf/next check:full",
    "format": "prettier --write ."
  },
  "keywords": [
    "gallery",
    "images",
    "monorepo",
    "react",
    "fastify"
  ],
  "author": "PixiShelf Team",
  "license": "MIT",
  "packageManager": "pnpm@8.15.1",
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/node": "^20.8.0",
    "lint-staged": "^15.0.2",
    "oxlint": "^1.32.0",
    "prettier": "^3.0.3",
    "shadcn": "^3.3.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
